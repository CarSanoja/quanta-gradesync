GRADESYNC_GCP_PROJECT_ID=your-gcp-project-id
GRADESYNC_GCP_REGION=us-central1

GRADESYNC_GEMINI_PRO_MODEL=gemini-3.5-flash
GRADESYNC_GEMINI_FLASH_MODEL=gemini-3.5-flash-lite
GRADESYNC_EMBEDDING_MODEL=text-embedding-005
GRADESYNC_GEMINI_LOCATION=global

GRADESYNC_PUBSUB_TOPIC=projects/your-gcp-project-id/topics/exam-batch-ingest
GRADESYNC_PUBSUB_PUSH_TOKEN=change-me-random-push-verification-token

GRADESYNC_GCS_BUCKET=your-exam-uploads-bucket
GRADESYNC_GCS_LOCAL_STAGING_DIR=.staging

GRADESYNC_FIRESTORE_JOBS_COLLECTION=jobs
GRADESYNC_FIRESTORE_CHECKPOINTS_COLLECTION=checkpoints
GRADESYNC_FIRESTORE_PROFILES_COLLECTION=profiles
GRADESYNC_FIRESTORE_COMPETENCIES_COLLECTION=competencies
GRADESYNC_FIRESTORE_PROMPTS_COLLECTION=prompts
GRADESYNC_FIRESTORE_REVIEWS_COLLECTION=reviews

GRADESYNC_SIS_BASE_URL=https://sis.example.edu/api/v1
GRADESYNC_SIS_API_TOKEN=change-me-sis-bearer-token
GRADESYNC_SIS_AUDIENCE=

GRADESYNC_RUNTIME_SERVICE_ACCOUNT=
GRADESYNC_SIS_WRITER_SERVICE_ACCOUNT=
GRADESYNC_AGENT_IMPERSONATION_ENABLED=false
GRADESYNC_AGENT_IMPERSONATION_LIFETIME_SECONDS=3600

GRADESYNC_GEMMA_MODEL=gemma-4-31b-it
GRADESYNC_GEMMA_API_KEY=

GRADESYNC_CONFIDENCE_THRESHOLD=0.85

GRADESYNC_OPTIMIZER_CANDIDATES=3

GRADESYNC_OPTIMIZER_MAX_CYCLES=3
GRADESYNC_OPTIMIZER_CONVERGENCE_MIN_IMPROVEMENT=0.01

GRADESYNC_VERIFY_MAX_ITERATIONS=2

GRADESYNC_MODEL_FALLBACK_LATENCY_SECONDS=90

GRADESYNC_HARNESS_MAX_CALLS_PER_ITEM=4
GRADESYNC_SCHEMA_REPAIR_ATTEMPTS=2
GRADESYNC_BATCH_ANOMALY_THRESHOLD=0.15
GRADESYNC_VARIANCE_COLLAPSE_RATIO=0.20

GRADESYNC_ARMOR_ENABLED=true
GRADESYNC_LEGIBILITY_ENABLED=true
GRADESYNC_LEGIBILITY_FULL_TRUST=0.70
GRADESYNC_LEGIBILITY_CONFIDENCE_FLOOR=0.50

GRADESYNC_OBJECTIVE_GATE_ENABLED=true
GRADESYNC_OBJECTIVE_QWK_MIN=0.85
GRADESYNC_OBJECTIVE_MAE_MAX=0.4
GRADESYNC_OBJECTIVE_BIAS_ABS_MAX=0.1

GRADESYNC_RESUME_STALE_AFTER_SECONDS=600

GRADESYNC_BATCH_SETTLE_INTERVAL_SECONDS=5
GRADESYNC_BATCH_SETTLE_MAX_ROUNDS=18

GRADESYNC_LOCAL_MODE=true

GRADESYNC_API_HOST=0.0.0.0
GRADESYNC_API_PORT=8080

GRADESYNC_LOCAL_DATA_DIR=.local_data

GRADESYNC_TELEMETRY_LIVE_ENABLED=true
GRADESYNC_TELEMETRY_CLOUD_TRACE_ENABLED=true
GRADESYNC_TELEMETRY_CLOUD_METRICS_ENABLED=true
GRADESYNC_TELEMETRY_CAPTURE_CONTENT=true
GRADESYNC_TELEMETRY_PAYLOAD_MAX_CHARS=4000
GRADESYNC_LOG_JSON=false
